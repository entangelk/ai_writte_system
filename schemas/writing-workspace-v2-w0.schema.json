{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-writing-system/schemas/writing-workspace-v2-w0.schema.json",
  "title": "Writing Workspace V2 W0 public contract",
  "description": "Schema catalog. Consumers MUST select an exact operation or entity through a #/$defs/... fragment; the permissive catalog root is never an endpoint schema. v1.8.9 supersedes the flat ordered-unit shapes: the Scene (Draft) carries a required chapter_id, public unit_kind and the project-wide draft-order are removed, and ordering is Chapter/Scene parent-scoped (docs/plans/chapter-scene-hierarchy-decisions.md).",
  "x-contract-version": "v1.8.9",
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullableNonBlankString": {
      "oneOf": [
        { "$ref": "#/$defs/nonBlankString" },
        { "type": "null" }
      ]
    },
    "writingIntent": {
      "enum": ["append_current", "start_next_unit"]
    },
    "projectBriefVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "version_number", "premise", "genre", "tone", "pov", "constraints", "style_rules", "preferred_patterns", "forbidden_patterns", "style_examples"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "project_id": { "$ref": "#/$defs/nonBlankString" },
        "version_number": { "type": "integer", "minimum": 1 },
        "premise": { "$ref": "#/$defs/nullableNonBlankString" },
        "genre": { "$ref": "#/$defs/nullableNonBlankString" },
        "tone": { "$ref": "#/$defs/nullableNonBlankString" },
        "pov": { "$ref": "#/$defs/nullableNonBlankString" },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "$comment": "uniqueItems checks the raw array. HTTP validation trims each item first and rejects post-trim duplicates such as ['a', ' a'].",
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "style_rules": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "preferred_patterns": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "forbidden_patterns": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "style_examples": {
          "type": "array", "uniqueItems": true,
          "$comment": "Runtime max items/chars are environment-adjustable and apply only to writes; existing version reads ignore the current runtime limit. HTTP request validation is authoritative.",
          "items": { "$ref": "#/$defs/nonBlankString" }
        }
      }
    },
    "projectBriefPutRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_version_id", "idempotency_key", "premise", "genre", "tone", "pov", "constraints", "style_rules", "preferred_patterns", "forbidden_patterns", "style_examples"],
      "properties": {
        "base_version_id": {
          "oneOf": [
            { "$ref": "#/$defs/nonBlankString" },
            { "type": "null" }
          ]
        },
        "idempotency_key": { "$ref": "#/$defs/nonBlankString" },
        "premise": { "$ref": "#/$defs/nullableNonBlankString" },
        "genre": { "$ref": "#/$defs/nullableNonBlankString" },
        "tone": { "$ref": "#/$defs/nullableNonBlankString" },
        "pov": { "$ref": "#/$defs/nullableNonBlankString" },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "$comment": "uniqueItems checks the raw array. HTTP validation trims each item first and rejects post-trim duplicates such as ['a', ' a'].",
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "style_rules": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "preferred_patterns": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "forbidden_patterns": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "style_examples": {
          "type": "array", "uniqueItems": true,
          "$comment": "Runtime max items/chars are environment-adjustable and apply only to writes; existing version reads ignore the current runtime limit. HTTP request validation is authoritative.",
          "items": { "$ref": "#/$defs/nonBlankString" }
        }
      }
    },
    "projectBriefGetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief"],
      "properties": {
        "brief": {
          "oneOf": [
            { "$ref": "#/$defs/projectBriefVersion" },
            { "type": "null" }
          ]
        }
      }
    },
    "projectBriefPutResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "idempotent_replay"],
      "properties": {
        "brief": { "$ref": "#/$defs/projectBriefVersion" },
        "idempotent_replay": { "type": "boolean" }
      }
    },
    "projectBriefVersionListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versions"],
      "properties": {
        "versions": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectBriefVersion" }
        }
      }
    },
    "draftV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "chapter_id", "title", "archived", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "project_id": { "$ref": "#/$defs/nonBlankString" },
        "chapter_id": { "$ref": "#/$defs/nonBlankString" },
        "title": { "$ref": "#/$defs/nonBlankString" },
        "archived": { "type": "boolean" },
        "position": { "type": "integer", "minimum": 1 }
      }
    },
    "chapterOrderPutRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_chapter_ids"],
      "properties": {
        "ordered_chapter_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        }
      }
    },
    "chapterOrderPutResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapters"],
      "properties": {
        "chapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/chapterV2" }
        }
      }
    },
    "sceneOrderPutRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_draft_ids"],
      "properties": {
        "ordered_draft_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        }
      }
    },
    "sceneOrderPutResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenes"],
      "properties": {
        "scenes": {
          "type": "array",
          "items": { "$ref": "#/$defs/draftV2" }
        }
      }
    },
    "chapterV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "title", "archived", "position", "scenes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "project_id": { "$ref": "#/$defs/nonBlankString" },
        "title": { "$ref": "#/$defs/nonBlankString" },
        "archived": { "type": "boolean" },
        "position": { "type": "integer", "minimum": 1 },
        "scenes": {
          "type": "array",
          "items": { "$ref": "#/$defs/draftV2" }
        }
      }
    },
    "nextUnitSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "goal"],
      "properties": {
        "title": { "$ref": "#/$defs/nonBlankString" },
        "goal": { "$ref": "#/$defs/nullableNonBlankString" }
      }
    },
    "contextPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "version_id"],
      "properties": {
        "draft_id": { "$ref": "#/$defs/nonBlankString" },
        "version_id": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "writingAcceptCommon": {
      "type": "object",
      "required": [
        "request_id", "draft_id", "base_version_id", "idempotency_key",
        "instruction", "candidate_text", "task_type", "output_type",
        "draft_excerpt", "query", "current_position", "max_tokens",
        "intent", "next_unit"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/nonBlankString" },
        "draft_id": { "$ref": "#/$defs/nonBlankString" },
        "base_version_id": { "$ref": "#/$defs/nonBlankString" },
        "idempotency_key": { "$ref": "#/$defs/nonBlankString" },
        "instruction": { "$ref": "#/$defs/nonBlankString" },
        "candidate_text": { "$ref": "#/$defs/nonBlankString" },
        "task_type": { "const": "continue_scene" },
        "output_type": { "const": "draft_patch" },
        "draft_excerpt": { "type": "string" },
        "query": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "current_position": { "$ref": "#/$defs/contextPosition" },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "intent": { "$ref": "#/$defs/writingIntent" },
        "next_unit": {
          "oneOf": [
            { "$ref": "#/$defs/nextUnitSpec" },
            { "type": "null" }
          ]
        }
      }
    },
    "writingAcceptRequestV2": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/writingAcceptCommon" },
            {
              "type": "object",
              "properties": {
                "intent": { "const": "append_current" },
                "next_unit": { "type": "null" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/writingAcceptCommon" },
            {
              "type": "object",
              "properties": {
                "intent": { "const": "start_next_unit" },
                "next_unit": { "$ref": "#/$defs/nextUnitSpec" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "savedWritingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "draft_version_id", "version_number", "snapshot_id", "content_hash", "chapter_id", "position"],
      "properties": {
        "draft_id": { "$ref": "#/$defs/nonBlankString" },
        "draft_version_id": { "$ref": "#/$defs/nonBlankString" },
        "version_number": { "type": "integer", "minimum": 1 },
        "snapshot_id": { "$ref": "#/$defs/nonBlankString" },
        "content_hash": { "$ref": "#/$defs/nonBlankString" },
        "chapter_id": { "$ref": "#/$defs/nonBlankString" },
        "position": { "type": "integer", "minimum": 1 }
      }
    },
    "writingAcceptResponseV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "intent", "gate", "saved", "analysis_job", "idempotent_replay"],
      "properties": {
        "accepted": { "type": "boolean" },
        "intent": { "$ref": "#/$defs/writingIntent" },
        "gate": {
          "oneOf": [
            { "type": "object" },
            { "type": "null" }
          ]
        },
        "saved": {
          "oneOf": [
            { "$ref": "#/$defs/savedWritingTarget" },
            { "type": "null" }
          ]
        },
        "analysis_job": {
          "oneOf": [
            { "type": "object" },
            { "type": "null" }
          ]
        },
        "idempotent_replay": { "type": "boolean" }
      }
    },
    "writingAcceptAnalysisPartialV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "intent", "saved", "analysis_job", "analysis_error"],
      "properties": {
        "accepted": { "const": true },
        "intent": { "$ref": "#/$defs/writingIntent" },
        "saved": { "$ref": "#/$defs/savedWritingTarget" },
        "analysis_job": { "type": "null" },
        "analysis_error": { "$ref": "#/$defs/nonBlankString" }
      }
    }
  }
}
