# 호스트 게시 포트 (host-published ports)
#
# 왜 표준 포트를 안 쓰는가
# -----------------------
# 이 프로젝트는 여러 개발 머신을 옮겨 다니며 작업한다. 표준 포트(27017 ·
# 8000~8003 · 9200 · 5173)를 쓰면 머신마다 다른 프로젝트와 충돌하고, 그때마다
# shell env로 임시 회피하게 된다. 그 임시값은 repo에 남지 않으므로
#   (1) 다음 머신에서 재현되지 않고,
#   (2) 작업자가 문서에 "지금 8001에 떠 있다" 같은 **머신-로컬 관측치를
#       프로젝트 사실처럼** 적게 된다 (2026-07-23에 실제로 발생: HANDOFF가
#       Chroma를 8001로 기록했으나 8001은 다른 프로젝트 컨테이너였다).
# 그래서 아래 전용 대역을 compose 기본값으로 못박았다. **env 없이
# `docker compose up`만 해도 어느 머신에서든 같은 포트로 뜬다.**
#
# 이 파일은 그 기본값의 사본이다. 특정 머신에서만 바꿔야 하면 `.env`로
# 복사해서 고친다 (`.env`는 커밋하지 않는다).
#
#     cp .env.example .env
#
# 컨테이너 **내부** 포트는 여기서 바꾸지 않는다. 서비스끼리는 도커 네트워크
# 안에서 `application:8000` · `mongo:27017`처럼 내부 이름/포트로 통신하므로
# 아래 값과 무관하다. 여기 있는 것은 호스트에서 보이는 번호뿐이다.

MONGO_PORT=27520
APPLICATION_PORT=8520
GATEWAY_PORT=8521
EMBEDDING_PORT=8522
CHROMA_PORT=8523
ELASTICSEARCH_PORT=9520
FRONTEND_PORT=5520

# 테스트 전용 Mongo(단일노드 replica set)는 별도 파일에서 뜬다:
#     docker compose -f docker-compose.test.yml up -d
# 기본 27020이며 `TEST_MONGO_PORT`로 조정한다. 배포 Mongo와 별개 컨테이너·
# 별개 포트라 동시에 떠 있어도 충돌하지 않는다. 테스트의 기본 접속 URI가
# 27020으로 하드코딩돼 있으므로 이 값을 바꾸면 `CORE_SOT_TEST_MONGO_URI`도
# 함께 넘겨야 한다.
TEST_MONGO_PORT=27020
