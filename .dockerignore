# Keep the build context small and the dependency-install cache layer stable.
# NOTE: scripts/ is NOT excluded — the b-6 index-sync worker shares the
# application image and needs scripts/index_sync_worker.py in the context.
**/__pycache__/
**/*.pyc
.git/
.gitignore
docs/
tests/
*.md
.venv/
venv/

# Frontend: the image builds the bundle from source (services/frontend/Dockerfile),
# so host install/build output must not enter the context or shadow the npm ci layer.
frontend/node_modules/
frontend/dist/
